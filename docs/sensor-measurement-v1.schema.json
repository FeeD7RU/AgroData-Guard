{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "measurement_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurement Id"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "sensor_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[\\w.:-]+$",
      "title": "Sensor Id",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value"
    },
    "node_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Node Id"
    },
    "feature": {
      "default": "unknown",
      "maxLength": 80,
      "minLength": 1,
      "title": "Feature",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "maxLength": 32,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "location_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location Id"
    },
    "quality": {
      "default": "good",
      "enum": [
        "good",
        "uncertain",
        "bad"
      ],
      "title": "Quality",
      "type": "string"
    },
    "source": {
      "default": "unspecified",
      "maxLength": 128,
      "title": "Source",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "sequence_number": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sequence Number"
    }
  },
  "required": [
    "timestamp",
    "sensor_id",
    "value"
  ],
  "title": "SensorMeasurement",
  "type": "object"
}